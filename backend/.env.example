# Copy to .env (never commit .env). All keys stay server-side.
APP_ENV=dev                      # dev allows http://localhost:* and 127.0.0.1:* for Flutter web
CORS_ORIGINS=                    # comma-separated explicit origins (required outside dev)
AI_BACKEND_API_KEY=              # optional shared secret; if set, clients must send X-API-Key

OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3.5-lightning:free

GLADIA_API_KEY=
GLADIA_MODEL=solaria-1
GLADIA_LANGUAGES=de,en           # used when the client does not pass a language

MAX_AUDIO_BYTES=10000000
MAX_AUDIO_SECONDS=60
MAX_INSTRUCTION_CHARS=2000
DEFAULT_TIMEZONE=Europe/Berlin
